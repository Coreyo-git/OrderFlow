# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres image tag shared by docker-compose and the Testcontainers test fixture,
# so dev and test don't silently drift onto different Postgres versions.
POSTGRES_IMAGE=postgres:16-alpine

# Per-service Postgres credentials, kept separate so one leaked password
# doesn't expose every database.
CUSTOMERDB_USER=orderflow
CUSTOMERDB_PASSWORD=changeme

ORDERDB_USER=orderflow
ORDERDB_PASSWORD=changeme
